{
    "name": "trophies-api",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "dev": "concurrently \"bun --watch /index.ts\" \"tsc --watch --noEmit\"",
        "typecheck": "tsc --noEmit",
        "production": "bun run migration:run && bun run /index.ts",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:create": "npm run typeorm migration:create",
        "migration:generate": "npm run typeorm -- migration:generate -d src/infrastructure/config/migration.config.ts",
        "migration:run": "npm run typeorm -- migration:run -d src/infrastructure/config/migration.config.ts",
        "migration:revert": "npm run typeorm -- migration:revert -d src/infrastructure/config/migration.config.ts",
        "migration:show": "npm run typeorm -- migration:show -d src/infrastructure/config/migration.config.ts"
    },
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@nestjs/common": "11.1.8",
        "@nestjs/core": "11.1.8",
        "@nestjs/platform-express": "11.1.8",
        "@nestjs/typeorm": "11.0.0",
        "@retroachievements/api": "^2.7.0",
        "axios": "1.9.0",
        "bcryptjs": "3.0.2",
        "cheerio": "1.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "dotenv": "16.4.1",
        "express": "5.1.0",
        "jsonwebtoken": "9.0.2",
        "pg": "8.15.6",
        "rxjs": "7.8.2",
        "typeorm": "0.3.23",
        "user-agents": "1.1.669"
    },
    "devDependencies": {
        "@types/axios": "0.9.36",
        "@types/dotenv": "8.2.0",
        "@types/express": "5.0.1",
        "@types/jest": "29.5.12",
        "@types/jsonwebtoken": "9.0.9",
        "@types/node": "22.15.17",
        "@types/pg": "8.11.0",
        "@types/supertest": "6.0.2",
        "@types/user-agents": "1.0.4",
        "@types/ws": "8.18.1",
        "bun-types": "1.2.20",
        "concurrently": "9.2.0",
        "jest": "29.7.0",
        "prettier": "3.5.3",
        "supertest": "6.3.4",
        "ts-jest": "29.1.2",
        "ts-node": "10.9.2",
        "ts-node-dev": "2.0.0",
        "typescript": "5.8.3"
    }
}
